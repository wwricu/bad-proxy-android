<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tunnel_test"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tunnel_test"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="@string/nodes_heading"
            android:textStyle="bold" />

        <Button
            android:id="@+id/add_node"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_node"
            android:textSize="12sp" />
    </LinearLayout>

    <ListView
        android:id="@+id/nodes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#dddddd"
        android:dividerHeight="1dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="@string/route_heading"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/routing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/route_global"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_global" />

        <RadioButton
            android:id="@+id/route_cn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_cn" />

        <RadioButton
            android:id="@+id/route_gfw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/route_gfw" />
    </RadioGroup>

    <CheckBox
        android:id="@+id/auto_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_connect" />

    <Button
        android:id="@+id/connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/connect" />
</LinearLayout>
